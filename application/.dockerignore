
# we need to install the node_modules ourselves - we never want to pick up those installed locally on
# the dev machine
backend/node_modules/
frontend/node_modules/

# these folders can be built into on the dev machine - we never want them in the docker
backend/client/
frontend/build/

backend/coverage/

# ignore all files generated by the Gel tooling - we will generate these
# inside the Docker image
backend/dbschema/edgeql-js/
backend/dbschema/interfaces.ts
backend/dbschema/queries.ts

# ignore all tiny dev datasets - these should not be needed in any Docker
# deployment
backend/datasets/

**/.DS_Store
